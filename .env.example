# Copy this file to .env and fill in real values:  cp .env.example .env
#
# .env is git-ignored; this file is committed so anyone cloning the repo
# knows exactly which keys the app needs.

# How the app reaches Postgres:
#   postgresql://user:password@host:port/database
#
# Running the app on your machine against the Stage 0 container:
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/tasks
#
# docker compose overrides this with host "db" (the service name), because
# inside the compose network the database is not on localhost.

# Used by the db service to initialise Postgres on its very first start.
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=tasks

# ---------------------------------------------------------------------
# Assignment A4 -- the Auth API in auth/
# ---------------------------------------------------------------------
#
# Both values come from your Supabase dashboard:
#   Project Settings -> API
#
# SUPABASE_KEY must be the *anon* (public) key. Never put the
# service_role key here: it bypasses every security rule Supabase has.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_ANON_KEY

# Port the Auth API listens on.
PORT=8000
